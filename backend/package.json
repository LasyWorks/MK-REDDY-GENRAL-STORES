{
  "name": "mk-reddy-genral-stores-backend",
  "version": "1.0.0",
  "description": "Production-ready backend for MK Reddy General Stores grocery e-commerce",
  "main": "src/server.js",
  "scripts": {
    "start": "node --no-experimental-fetch src/server.js",
    "start:cluster": "node src/cluster.js",
    "dev": "nodemon src/server.js",
    "dev:cluster": "nodemon src/cluster.js",
    "migrate": "node src/database/migrate.js",
    "seed:orders": "node scripts/seed-orders.js",
    "seed:categories": "node scripts/seed-categories.js",
    "test": "jest --coverage"
  },
  "keywords": [
    "grocery",
    "ecommerce",
    "nodejs",
    "express",
    "mysql"
  ],
  "author": "MK Reddy General Stores",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "google-auth-library": "^10.6.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.1.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^8.0.1",
    "pg": "^8.11.3",
    "uuid": "8.3.2",
    "winston": "^3.11.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
