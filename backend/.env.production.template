# ============================================================
# PRODUCTION .env for Mileweb Shared Hosting
# Fill in your actual values, rename to .env, upload to server
# NEVER commit this file to git
# ============================================================

NODE_ENV=production
PORT=3000
API_VERSION=v1

# ── PostgreSQL (from Mileweb cPanel → PostgreSQL Databases) ─
DB_HOST=localhost
DB_PORT=5432
DB_USER=cpaneluser_dbuser        # e.g. mysite_mkreddy
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=cpaneluser_mkreddy       # e.g. mysite_mkreddy
DB_CONNECTION_LIMIT=5
DB_SSL=false

# ── JWT (generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ──
JWT_SECRET=GENERATE_A_128_CHAR_HEX_STRING
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=GENERATE_ANOTHER_128_CHAR_HEX_STRING
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS (your Vercel frontend URL) ─────────────────────────
CORS_ORIGIN=https://your-app.vercel.app

# ── Email SMTP (from Mileweb cPanel → Email Accounts) ───────
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=YOUR_EMAIL_PASSWORD
EMAIL_FROM=noreply@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# ── Store Info ───────────────────────────────────────────────
STORE_NAME=MK Reddy General Stores
STORE_GST_NUMBER=29XXXXX1234X1ZX
STORE_ADDRESS=123 Main Bazaar, Hyderabad, Telangana - 500001
STORE_PHONE=+91-9000000000
STORE_EMAIL=contact@yourdomain.com

# ── OTP ──────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Business Limits ──────────────────────────────────────────
MAX_CUSTOMERS=50
MAX_PRODUCTS=500
RETAIL_MAX_QUANTITY=10
WHOLESALE_MAX_QUANTITY=100

# ── Misc ─────────────────────────────────────────────────────
DEFAULT_LANGUAGE=en

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
