# ============================================================
# MK Reddy General Stores — Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# ── Application ─────────────────────────────────────────────
NODE_ENV=development          # development | production | test
PORT=5001
API_VERSION=v1

# ── PostgreSQL Database ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=mk_kirana_stores
DB_CONNECTION_LIMIT=10
DB_SSL=false                   # set true on managed cloud DBs (Supabase, RDS, etc.)

# ── JWT Configuration ────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_strong_random_64_char_secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=change_this_to_another_strong_random_64_char_secret
JWT_REFRESH_EXPIRES_IN=7d

# ── OTP / Phone Verification ─────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000     # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
OTP_RATE_LIMIT_WINDOW_MS=60000  # 1 minute
OTP_RATE_LIMIT_MAX_REQUESTS=3

# ── Email / SMTP ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password   # Google App Password (not account password)

# ── Store Information ────────────────────────────────────────
STORE_NAME=MK Reddy General Stores
STORE_GST_NUMBER=29XXXXX1234X1ZX
STORE_ADDRESS=123 Main Bazaar, Hyderabad, Telangana - 500001
STORE_PHONE=+91-9000000000
STORE_EMAIL=contact@mkreddystores.com

# ── Business Limits ──────────────────────────────────────────
MAX_CUSTOMERS=50
MAX_PRODUCTS=500

# ── Multilingual ─────────────────────────────────────────────
DEFAULT_LANGUAGE=en             # en | te

# ── Fast2SMS (OTP delivery via SMS) ─────────────────────────
# Get API key at https://www.fast2sms.com  — not required in development
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=MKRDDY
FAST2SMS_ROUTE=dlt
FAST2SMS_MESSAGE_ID=

# ── WhatsApp Order Notifications ─────────────────────────────
# Supported providers: twilio | 360dialog — not required in development
WA_PROVIDER=twilio

# Twilio (WhatsApp sandbox)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WA_FROM_NUMBER=whatsapp:+14155238886

# 360dialog (alternative)
WA_360_API_KEY=
WA_360_NAMESPACE=

# ── CORS ─────────────────────────────────────────────────────
# In production set this to your frontend origin, e.g. https://app.mkreddystores.com
CORS_ORIGIN=*
