# ============================================================
# MK Reddy General Stores — Backend Environment Configuration
# Copy this file to .env and fill in your values.
# ⚠️ NEVER commit the actual .env file to version control.
# ⚠️ CRITICAL: Generate new secrets for production! Do NOT use these examples.
# ============================================================

# ── Application ─────────────────────────────────────────────
NODE_ENV=development          # development | production | test
PORT=5001
API_VERSION=v1

# ── PostgreSQL Database ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=mk_kirana_stores
DB_CONNECTION_LIMIT=20
DB_SSL=false                   # set true on managed cloud DBs (Supabase, RDS, etc.)

# ── JWT Configuration ────────────────────────────────────────
# ⚠️ CRITICAL: Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# DO NOT use weak secrets - they must be random 128-character hex strings
JWT_SECRET=change_this_to_a_strong_random_64_char_secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=change_this_to_another_strong_random_64_char_secret
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS Configuration ───────────────────────────────────────
# ⚠️ REQUIRED: Set to your frontend URL (e.g., https://yourdomain.com)
# NEVER use wildcard (*) in production - this is a critical security vulnerability
CORS_ORIGIN=http://localhost:3000

# ── OTP / Phone Verification ─────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000     # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
OTP_RATE_LIMIT_WINDOW_MS=60000  # 1 minute
OTP_RATE_LIMIT_MAX_REQUESTS=3

# ── Email / SMTP ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password   # Google App Password (not account password)

# ── Store Information ────────────────────────────────────────
STORE_NAME=MK Reddy General Stores
STORE_GST_NUMBER=29XXXXX1234X1ZX
STORE_ADDRESS=123 Main Bazaar, Hyderabad, Telangana - 500001
STORE_PHONE=+91-9000000000
STORE_EMAIL=contact@mkreddystores.com

# ── Business Limits ──────────────────────────────────────────
MAX_CUSTOMERS=50
MAX_PRODUCTS=500
# Default max quantity per product for retail customers (wholesale has no limit)
RETAIL_MAX_QUANTITY=10
WHOLESALE_MAX_QUANTITY=100

# ── Multilingual ─────────────────────────────────────────────
DEFAULT_LANGUAGE=en             # en | te

# ── CORS ─────────────────────────────────────────────────────
# In production set this to your frontend origin, e.g. https://app.mkreddystores.com
CORS_ORIGIN=*
